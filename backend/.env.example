DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# sqlite (default) | postgres
DB_ENGINE=postgres
DB_NAME=newsround
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
# Requires PostGIS extension + GDAL/GEOS on the host
USE_POSTGIS=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Demo OTP returns the code in the API response. Set false and wire an SMS provider for production.
OTP_DEMO_MODE=true
# simulated | razorpay | cashfree  (only 'simulated' is implemented in the prototype)
PAYMENT_GATEWAY=simulated
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
